# Sentinel AI — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# -------------------------------------------------------------------------
# Phase 5: News Evidence
# -------------------------------------------------------------------------
# NewsAPI key from https://newsapi.org
# Leave blank to use the mock news provider.
NEWS_API_KEY=

# News provider mode: "mock" (default, no API calls) or "live" (requires NEWS_API_KEY)
SENTINEL_NEWS_PROVIDER=mock

# Evidence data backend: "fixture" (default; unit-test fixtures ACC001-ACC004)
# or "india_synthetic" (dataset/processed/custom_india, point-in-time).
# The investigation scripts default to india_synthetic.
SENTINEL_EVIDENCE_BACKEND=fixture

# Agent 1: fail at startup if the IEEE-CIS models are missing ("true",
# default). Hosted deployments set "false": they ship only the India model
# (see docs/14_OPERATIONS/DEPLOYMENT.md).
SENTINEL_REQUIRE_IEEE_MODELS=true

# -------------------------------------------------------------------------
# LLM Provider (Phase 6+)
# -------------------------------------------------------------------------
# "groq" or "anthropic"
LLM_PROVIDER=groq
GROQ_API_KEY=

# -------------------------------------------------------------------------
# MongoDB Atlas — Case persistence (Phase 6+)
# -------------------------------------------------------------------------
MONGODB_URI=

# -------------------------------------------------------------------------
# Neo4j — Account network analysis (Phase 7)
# -------------------------------------------------------------------------
# For Neo4j AuraDB: use the instance URI from the AuraDB console.
# NEO4J_DATABASE: for AuraDB, use the instance ID (e.g. "abc12345"), NOT "neo4j".
# For a local Neo4j instance, use "neo4j" or your configured database name.
# Local Docker (recommended for development): NEO4J_URI=bolt://localhost:7687
# See docs/14_OPERATIONS/DEVELOPMENT_SETUP.md.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
