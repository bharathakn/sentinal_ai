# Sentinel AI — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# -------------------------------------------------------------------------
# Phase 5: News Evidence
# -------------------------------------------------------------------------
# NewsAPI key from https://newsapi.org
# Leave blank to use the mock news provider.
NEWS_API_KEY=

# News provider mode: "mock" (default, no API calls) or "live" (requires NEWS_API_KEY)
SENTINEL_NEWS_PROVIDER=mock

# Evidence data backend: "fixture" (default; unit-test fixtures ACC001-ACC004)
# or "india_synthetic" (dataset/processed/custom_india, point-in-time).
# The investigation scripts default to india_synthetic.
SENTINEL_EVIDENCE_BACKEND=fixture

# Agent 1: fail at startup if the IEEE-CIS models are missing ("true",
# default). Hosted deployments set "false": they ship only the India model
# (see docs/14_OPERATIONS/DEPLOYMENT.md).
SENTINEL_REQUIRE_IEEE_MODELS=true

# -------------------------------------------------------------------------
# LLM Provider (Phase 6+)
# -------------------------------------------------------------------------
# Agent 5 report writer. Only "groq" is implemented; any other value uses the
# deterministic template writer.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional (defaults shown). See docs/02_AGENTS/AGENT_5_EXPLANATION_GENERATOR.md
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_STRICT_SCHEMA=true
# GROQ_MAX_COMPLETION_TOKENS=2500
# GROQ_TPM_LIMIT=8000
# GROQ_TIMEOUT_SECONDS=45
# GROQ_MAX_RATE_LIMIT_WAIT=10
# "llm" (default; falls back to template on any LLM failure) or "template"
SENTINEL_REPORT_GENERATOR=llm

# LangGraph pulls in LangSmith. Keep tracing OFF: enabling it sends case data
# to an external service.
LANGSMITH_TRACING=false

# -------------------------------------------------------------------------
# Case store + API (Phase 13) — see docs/09_BACKEND/API_DESIGN.md
# -------------------------------------------------------------------------
# "json" (default; files under SENTINEL_CASE_DIR, local development only) or
# "mongodb" (MongoDB Atlas; required on Render, whose disk is ephemeral).
SENTINEL_CASE_STORE=json
# SENTINEL_CASE_DIR=var/cases
MONGODB_URI=
# MONGODB_DATABASE=sentinel_ai
# Browser origins allowed to call the API (comma-separated; no "*").
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional: when set, POST /api/v1/alerts requires header X-API-Key with this value.
SENTINEL_INGEST_API_KEY=
# SENTINEL_MAX_PENDING_CASES=50
# SENTINEL_ALERT_WAIT_SECONDS=180

# -------------------------------------------------------------------------
# Neo4j — Account network analysis (Phase 7)
# -------------------------------------------------------------------------
# For Neo4j AuraDB: use the instance URI from the AuraDB console.
# NEO4J_DATABASE: for AuraDB, use the instance ID (e.g. "abc12345"), NOT "neo4j".
# For a local Neo4j instance, use "neo4j" or your configured database name.
# Local Docker (recommended for development): NEO4J_URI=bolt://localhost:7687
# See docs/14_OPERATIONS/DEVELOPMENT_SETUP.md.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
